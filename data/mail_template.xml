<odoo>
    <record id="email_template_student_enrollment" model="mail.template">
        <field name="name">Student Enrollment Confirmation</field>
        <field name="model_id" ref="model_school_student_registry"/>
        <field name="subject">Enrollment Confirmed - {{ object.name }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="email_from">{{ user.email or 'noreply@yourschool.com' }}</field>
        <field name="body_html" type="html">
            <p>Dear <t t-out="object.name"/>,</p>
            <p>Congratulations! Your enrollment has been confirmed.</p>
            <p>Regards,<br/>School Administration</p>
        </field>
    </record>
</odoo>